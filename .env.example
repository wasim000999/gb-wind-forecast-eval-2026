# ========================================================
# REint Full Stack Energy Forecasting Platform Environment
# ========================================================

PROJECT_NAME="GB Wind Generation Forecast Evaluation"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# Server Host & Port
PORT=8000
HOST="0.0.0.0"

# Elexon BMRS API Configuration
ELEXON_BASE_URL="https://data.elexon.co.uk/bmrs/api/v1"
ELEXON_TIMEOUT_SECONDS=30.0
ELEXON_MAX_RETRIES=3

# Default Day-Ahead wholesale market gate closure cutoff:
# D1_1100 = 11:00 London local time on Day D-1 (GB Day-Ahead Auction standard)
# D1_1200 = 12:00 London local time on Day D-1 (Pan-European Coupling standard)
# ROLLING_24H = 24 hours prior to delivery start
DEFAULT_CUTOFF_STRATEGY="D1_1100"

# Target delivery period
TARGET_START_UTC="2026-01-01T00:00:00Z"
TARGET_END_UTC="2026-01-31T23:59:59Z"

# Frontend Environment Variables (for Vite build)
VITE_API_BASE_URL="/api"
